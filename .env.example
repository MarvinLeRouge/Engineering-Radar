# Copy to .env and fill in real values. .env is gitignored, never commit real secrets here.

# Absolute path to the project's SQLite database, shared by radar-api, radar-audit,
# and radar-core's alembic migrations. Always set explicitly -- never assumed.
RADAR_DATABASE_URL=sqlite:////absolute/path/to/Engineering-Radar/radar.db

# Shared secret required on every radar-api PATCH endpoint (sent as the X-API-Key
# header). Generate a real random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
RADAR_API_KEY=

# Only used by `docker compose up` to mount the portfolio config into the
# radar-audit CLI container. Defaults to ./portfolio if unset.
RADAR_PORTFOLIO_PATH=./portfolio
