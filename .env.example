# Copy to .env and fill in real values. .env is gitignored, never commit real secrets here.

# Absolute path to the project's SQLite database, shared by radar-api, radar-audit,
# and radar-core's alembic migrations. Always set explicitly -- never assumed.
RADAR_DATABASE_URL=sqlite:////absolute/path/to/Engineering-Radar/radar.db

# Shared secret required on every radar-api PATCH endpoint (sent as the X-API-Key
# header). Generate a real random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
RADAR_API_KEY=

# Only used by `docker compose up` to mount the portfolio config into the
# radar-audit CLI container. Defaults to ./portfolio if unset.
RADAR_PORTFOLIO_PATH=./portfolio

# Host folder holding radar.db, bind-mounted as /data in the radar-api and
# radar-audit containers (the radar-data volume). Absolute path, no trailing slash.
RADAR_PROJECT_PATH=/absolute/path/to/Engineering-Radar

# Optional Sentry error tracking; leave a DSN empty to disable it.
# SENTRY_BACKEND_DSN is shared by radar-api and the radar-audit CLI. The frontend
# DSN is baked in at image build time: rebuild radar-dashboard after changing it.
SENTRY_BACKEND_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=development

# Structured logs (radar-api, radar-audit), written to stderr.
# RADAR_LOG_LEVEL: debug, info, warning, error. RADAR_LOG_FORMAT: json or console;
# empty means JSON in Docker and readable text in a terminal.
RADAR_LOG_LEVEL=info
RADAR_LOG_FORMAT=
